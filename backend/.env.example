# Copy to .env and fill in.
# Option A (recommended): standard PG env vars
PGHOST=localhost
PGPORT=5432
PGDATABASE=dros
PGUSER=postgres
PGPASSWORD=Minnam@1010

# Option B: connection string (overrides above if set)
# DATABASE_URL=postgres://postgres:password@localhost:5432/dros

PORT=3001

# Pool tuning (optional)
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONN_TIMEOUT_MS=5000

# Twilio SMS (demo-safe, outbound only)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

